# ---- Core ----------------------------------------------------------------
# Public base URL (used in customer notifications).
APP_BASE_URL=http://localhost:3000
# HMAC key for customer/admin session cookies. REQUIRED in production, 32+ chars.
SESSION_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# Owner/admin password (12+ chars). Admin is disabled while unset or short.
ADMIN_PASSWORD=
# Shared secret for signed webhooks (X-BrickLoop-Signature: t=..,v1=hmac_sha256).
WEBHOOK_SECRET=

# ---- Database ------------------------------------------------------------
# PostgreSQL connection string. When unset, an embedded PGlite (real Postgres
# compiled to WASM) database is stored in PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=./.data/pglite

# ---- Jobs ----------------------------------------------------------------
# Run the job worker inside the web server (required with PGlite).
# With PostgreSQL you may set INLINE_WORKER=false and run `npm run worker`.
INLINE_WORKER=true
WORKER_INTERVAL_MS=2000
SWEEP_EVERY_SECONDS=300
TRACK_POLL_SECONDS=20

# ---- Conversational editing ---------------------------------------------
# With a key, chat uses a server-side LLM with structured tools; every tool
# call is still validated by deterministic code. Without one, a rule-based
# mock planner is used. Force the mock with CHAT_MODE=mock.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
CHAT_MODE=

# ---- Suppliers & payments --------------------------------------------------
# Only "simulator" is implemented end to end. Real suppliers are listed with
# unverified (all false) capabilities; see docs/SUPPLIER_CAPABILITIES.md.
SUPPLIER=simulator
SUPPLIER_ALLOWLIST=simulator
# Only the sandbox provider ("simulated") is implemented.
PAYMENT_PROVIDER=simulated
# Master switch for live purchasing. Live mode ALSO requires every item in the
# admin "Live readiness" checklist (verified supplier, live payments, verified
# mappings, physical validations, limits saved, end-to-end check).
LIVE_PURCHASING_ENABLED=false
# Set only after a controlled real order has succeeded end to end.
# LIVE_E2E_VERIFIED_AT=

# ---- Simulator timing (simulation only) ----------------------------------
SIM_SHIP_AFTER_SECONDS=60
SIM_DELIVER_AFTER_SECONDS=180

# ---- Alerts & uploads ------------------------------------------------------
# Urgent alerts and digests are recorded in the notifications table (log
# channel); no email transport is connected yet.
ALERT_EMAIL=owner@example.com
UPLOAD_DIR=./.data/uploads
UPLOAD_MAX_BYTES=5242880
